<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yuki 屏幕日报"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="每晚 22:00 自动把当天屏幕使用汇总（总时长 + Top 应用）发到飞书「muse伴学」群。" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="飞书 App ID" />

        <EditText
            android:id="@+id/etAppId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="cli_..." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="飞书 App Secret（只存手机本地）" />

        <EditText
            android:id="@+id/etSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="从飞书开放平台的应用凭证里复制"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="群 chat_id" />

        <EditText
            android:id="@+id/etChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="oc_..." />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="保存配置" />

        <Button
            android:id="@+id/btnUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="① 打开「使用情况访问」授权" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="② 电池优化设为无限制" />

        <Button
            android:id="@+id/btnSendNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="立即上报一次（测试）" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="状态：—" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="华为保活（必做，不然 22:00 的定时会被系统杀掉）：\n1. 设置 → 电池 → 应用启动管理 → 找到「Yuki屏幕日报」→ 关闭「自动管理」→ 弹出框里三个开关全开（允许自启动 / 关联启动 / 后台活动）\n2. 最近任务里上滑停顿，长按本应用卡片 → 锁定\n3. 若「使用情况访问」列表里找不到本应用：设置 → 应用和服务 → 应用管理 → 右上角菜单 → 特殊访问权限 → 使用情况访问数据 → 找到本应用打开" />

    </LinearLayout>
</ScrollView>
